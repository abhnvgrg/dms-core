APP_NAME=NyayVault API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://nyayvault:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/nyayvault
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_USER
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_BUCKET=nyayvault-evidence
MINIO_SECURE=false

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30